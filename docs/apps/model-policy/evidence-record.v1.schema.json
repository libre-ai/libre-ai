{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-ai.fr/schemas/model-policy-evidence-record.v1.schema.json",
  "title": "Libre AI Model Policy gate evidence record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "phaseId",
    "gateId",
    "assertion",
    "achievedEvidenceLevel",
    "sourceCommit",
    "artifactDigests",
    "commands",
    "expectedResults",
    "observedResults",
    "findings",
    "verdict",
    "reviewerRoles",
    "harnessIdentifiers",
    "supportingReviews",
    "invalidationConditions",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.model-policy-evidence-record.v1" },
    "evidenceId": {
      "type": "string",
      "pattern": "^MP-EVD-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "phaseId": { "type": "string", "pattern": "^MP-P[0-9]+$" },
    "gateId": { "type": "string", "pattern": "^MP-P[0-9]+-G[0-9]{2}$" },
    "assertion": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "achievedEvidenceLevel": {
      "enum": ["declared", "implemented", "verified", "qualified", "in_service"]
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/digestedPath" }
    },
    "commands": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "expectedResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "observedResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "major", "minor", "residual"],
      "properties": {
        "blocking": { "$ref": "#/$defs/findingList" },
        "major": { "$ref": "#/$defs/findingList" },
        "minor": { "$ref": "#/$defs/findingList" },
        "residual": { "$ref": "#/$defs/findingList" }
      }
    },
    "verdict": {
      "enum": ["approve", "approve_with_minor_reservations", "reject", "not_applicable"]
    },
    "reviewerRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "harnessIdentifiers": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "supportingReviews": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docs/reviews/[A-Za-z0-9._/-]+\\.md$"
      }
    },
    "invalidationConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "digestedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "findingList": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
