{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-ai.fr/schemas/model-policy-phases.v1.schema.json",
  "title": "Libre AI Model Policy product phases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorityStatus", "updatedAt", "currentPhase", "phases"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.model-policy-phases.v1" },
    "authorityStatus": { "enum": ["proposed", "accepted", "superseded"] },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "currentPhase": { "type": "string", "pattern": "^MP-P[0-9]+$" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^MP-P[0-9]+-G[0-9]{2}$" },
        "status": { "enum": ["pending", "passed", "blocked"] },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "document",
        "status",
        "dependsOn",
        "blockedBy",
        "gates"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^MP-P[0-9]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 180 },
        "document": { "$ref": "#/$defs/repositoryPath" },
        "status": {
          "enum": ["not_started", "in_progress", "blocked", "complete", "superseded"]
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^MP-P[0-9]+$" }
        },
        "blockedBy": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/gate" }
        }
      }
    }
  }
}
