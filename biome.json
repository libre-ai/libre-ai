{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!distribution/index/repositories.v1.json",
      "!distribution/feeds/evidence.json",
      "!distribution/fixtures/evidence-feed",
      "!ecosystem/fixtures/repository-index/expected.json",
      "!ecosystem/projections/public.v1.json",
      "!contracts/fixtures/radar-engine-v2",
      "!docs/reviews/**/evidence",
      "!docs/transformation/inputs",
      "!packages/ui/color-system/generated",
      "!third_party/dtcg-format-2025.10"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
