{
  "name": "@libre-ai/ui",
  "version": "0.1.0",
  "description": "Accessible, verifiable UI primitives for the Libre AI sovereign application workshop (layer 4).",
  "license": "Apache-2.0",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "keywords": [
    "libre-ai",
    "ui",
    "react",
    "accessible",
    "react-aria"
  ],
  "homepage": "https://libre-ai.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/libre-ai/libre-ai.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tailwind": "./src/tailwind.ts"
  },
  "scripts": {
    "check:bun": "bun ../../tools/quality/check-bun-minimum.ts",
    "pretest": "bun run check:bun",
    "test": "bun test"
  },
  "dependencies": {
    "react-aria-components": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  }
}
