{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["bun", "react", "react-dom", "emscripten"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "ecosystem/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tools/**/*.ts",
    "verification/**/*.ts",
    "distribution/templates/**/*.ts",
    "distribution/templates/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "target", ".tools"]
}
