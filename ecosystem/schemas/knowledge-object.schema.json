{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-ai.fr/schemas/knowledge-object.v1.json",
  "title": "Libre AI Knowledge Object v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "status", "authority", "provenance"],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.knowledge-object.v1"
    },
    "kind": {
      "enum": [
        "Thesis",
        "Bet",
        "Hypothesis",
        "Capability",
        "Experience",
        "Decision",
        "Contract",
        "Implementation",
        "Evidence",
        "Learning",
        "Release"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^urn:libre-ai:[a-z][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": ["draft", "reviewed", "accepted", "deprecated", "archived", "untrusted"]
    },
    "trust": {
      "enum": ["external", "observed", "reviewed", "normative"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "owners"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "target": { "type": "string", "pattern": "^urn:libre-ai:" },
          "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "createdAt"],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "legacyRepository": { "type": "string", "format": "uri" },
        "legacyRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "model": { "type": "string" },
        "harness": { "type": "string" }
      }
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "supersedes": { "type": "string", "pattern": "^urn:libre-ai:" }
  }
}
